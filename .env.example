# Run scripts/configure.ps1 to generate random local credentials in .env.
POSTGRES_PASSWORD=replace-with-random-password
MEMBRIDGE_API_KEY=replace-with-random-token
# OpenAI-compatible API base including /v1. Empty values select offline extractive mode.
MEMBRIDGE_LLM_URL=
MEMBRIDGE_LLM_KEY=
MEMBRIDGE_LLM_MODEL=
MEMBRIDGE_EMBEDDING_MODEL=
